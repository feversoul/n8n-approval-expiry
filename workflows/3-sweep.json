      "id": "799954cb-a270-434e-81aa-45123340777a",
      "name": "Expire what is overdue",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        440,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const sweep = $('Now').first().json;\n// Only rows this run expired. A row that was approved in the same instant\n// can come back from the update on SQLite; its decision_id is not ours.\nconst expired = $input.all().map((item) => item.json)\n  .filter((row) => row.id !== undefined && row.status === 'expired' && row.decision_id === sweep.sweep_id)\n  .map((row) => ({ request_id: row.request_id, title: row.title, payload: row.payload, expires_at: new Date(row.expires_at).toISOString() }));\nreturn [{ json: { expired } }];"
      },
      "id": "a2084634-3269-4b14-8ee4-00d20513a160",
      "name": "Mine only",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
