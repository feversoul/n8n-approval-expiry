        "responseMode": "lastNode",
        "options": {}
      },
      "id": "6dc06cbf-ab7d-4ecb-82c2-d79c11dd0811",
      "name": "Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        100
      ],
      "webhookId": "efa00c0a-116c-4496-8122-60621fe2b572",
      "credentials": {
        "httpHeaderAuth": {
          "id": "approvalKey",
          "name": "Approval Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// How long a request stays open when the caller does not say.\nconst DEFAULT_TTL_SECONDS = 86400;\n\nconst input = $input.first().json;\n// Over the webhook the request is the body; from a sub-workflow call it is the item.\nconst request = input.webhookUrl && input.body ? input.body : input;\nconst title = String(request.title ?? '').trim();\nif (!title) throw new Error('An approval request needs a title');\nconst approvers = (Array.isArray(request.approvers) ? request.approvers : [request.approvers ?? 'approver']).map((name) => String(name).trim()).filter(Boolean);\nif (approvers.length === 0) throw new Error('An approval request needs at least one approver');\nconst ttl = Number(request.ttl_seconds ?? DEFAULT_TTL_SECONDS);\nif (!(ttl > 0)) throw new Error('ttl_seconds must be a positive number');\n\nconst shared = { title, details: String(request.details ?? ''), payload: JSON.stringify(request.payload ?? {}), ttl };\n// One item for the request id and one per approver: the next node gives each a random token.\nreturn [{ json: { slot: 'request', ...shared } }, ...approvers.map((name) => ({ json: { slot: 'approver', name } }))];"
      },
      "id": "edd4c9c9-5295-4fde-839b-0e2d7139d661",
      "name": "Entry",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "action": "generate",
        "dataPropertyName": "token",
        "encodingType": "hex",
        "stringLength": 32
      },
      "id": "5b06ab13-6c30-4987-83a7-e120ae041ac0",
      "name": "Random tokens",
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all().map((item) => item.json);\nconst head = items.find((item) => item.slot === 'request');\nconst approvers = items.filter((item) => item.slot === 'approver').map((item) => ({ name: item.name, token: item.token }));\nconst now = Date.now();\nreturn [{ json: {\n  request_id: head.token.slice(0, 24),\n  title: head.title,\n  details: head.details,\n  payload: head.payload,\n  status: 'pending',\n  approvers: JSON.stringify(approvers),\n  created_at: new Date(now).toISOString(),\n  // A number, so the decision and the sweep can compare it in the table filter.\n  expires_at: now + Math.round(head.ttl * 1000),\n} }];"
      },
      "id": "5da600b9-4790-4eac-8625-3692cbce5e94",
      "name": "Build the request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
